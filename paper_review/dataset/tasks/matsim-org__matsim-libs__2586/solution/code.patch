+							 .addQSimModule(
+						new WithinDayQSimModule(withinDayEngine, fixedOrderSimulationListener, withinDayTravelTime)) //
+							 .configureQSimComponents(WithinDayQSimModule::configureComponents ) //
+							 .build(scenario, eventsManager);
+	}
+}
