+            return match root.render(&options) {
+                Ok(content) => Ok((atoms::ok(), content).encode(env)),
+                Err(error) => Ok((atoms::error(), error.to_string()).encode(env)),
+            };
+        }
+        Err(error) => Ok((atoms::error(), error.to_string()).encode(env)),
