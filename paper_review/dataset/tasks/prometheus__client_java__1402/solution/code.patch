diff --git a/prometheus-metrics-exposition-formats/generate-protobuf.sh b/prometheus-metrics-exposition-formats/generate-protobuf.sh
--- a/prometheus-metrics-exposition-formats/generate-protobuf.sh
+++ b/prometheus-metrics-exposition-formats/generate-protobuf.sh
@@ -38,14 +38,14 @@ GENERATED_WITH=$(grep -oP '\/\/ Protobuf Java Version: \K.*' "$TARGET_DIR/${PACK
