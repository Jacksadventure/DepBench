diff --git a/local_jsonwebtoken/src/lib.rs b/local_jsonwebtoken/src/lib.rs
new file mode 100644
index 0000000..e3e1fde
--- /dev/null
+++ b/local_jsonwebtoken/src/lib.rs
@@ -0,0 +1,236 @@
+// Use std imports
+
+pub use jsonwebtoken_dep::errors;
+pub use jsonwebtoken_dep::{get_current_timestamp, Algorithm, Header, TokenData, Validation};
+
+extern crate jsonwebtoken_orig as jsonwebtoken_dep;
+
+#[derive(Clone)]
+pub struct DecodingKey {
+    pub inner: jsonwebtoken_dep::DecodingKey,
+    pub raw: Vec<u8>,
+}
+
+impl std::fmt::Debug for DecodingKey {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("DecodingKey")
+            .field("raw", &self.raw)
+            .finish()
+    }
+}
+
+impl PartialEq for DecodingKey {
+    fn eq(&self, other: &Self) -> bool {
+        self.raw == other.raw
+    }
+}
+
+impl DecodingKey {
+    pub fn from_secret(secret: &[u8]) -> Self {
+        DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_secret(secret),
+            raw: secret.to_vec(),
+        }
+    }
+
+    pub fn from_base64_secret(secret: &str) -> jsonwebtoken_dep::errors::Result<Self> {
+        let out = base64::Engine::decode(&base64::engine::general_purpose::STANDARD, secret)
+            .map_err(|_e| jsonwebtoken_dep::errors::ErrorKind::InvalidKeyFormat)?;
+        Ok(DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_base64_secret(secret)?,
+            raw: out,
+        })
+    }
+
+    pub fn from_rsa_pem(key: &[u8]) -> jsonwebtoken_dep::errors::Result<Self> {
+        Ok(DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_rsa_pem(key)?,
+            raw: key.to_vec(),
+        })
+    }
+
+    pub fn from_rsa_components(modulus: &str, exponent: &str) -> jsonwebtoken_dep::errors::Result<Self> {
+        Ok(DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_rsa_components(modulus, exponent)?,
+            raw: modulus.as_bytes().to_vec(),
+        })
+    }
+
+    pub fn from_rsa_raw_components(modulus: &[u8], exponent: &[u8]) -> Self {
+        DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_rsa_raw_components(modulus, exponent),
+            raw: modulus.to_vec(),
+        }
+    }
+
+    pub fn from_ec_pem(key: &[u8]) -> jsonwebtoken_dep::errors::Result<Self> {
+        Ok(DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_ec_pem(key)?,
+            raw: key.to_vec(),
+        })
+    }
+
+    pub fn from_ec_components(x: &str, y: &str) -> jsonwebtoken_dep::errors::Result<Self> {
+        Ok(DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_ec_components(x, y)?,
+            raw: x.as_bytes().to_vec(),
+        })
+    }
+
+    pub fn from_ed_pem(key: &[u8]) -> jsonwebtoken_dep::errors::Result<Self> {
+        Ok(DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_ed_pem(key)?,
+            raw: key.to_vec(),
+        })
+    }
+
+    pub fn from_rsa_der(der: &[u8]) -> Self {
+        DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_rsa_der(der),
+            raw: der.to_vec(),
+        }
+    }
+
+    pub fn from_ec_der(der: &[u8]) -> Self {
+        DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_ec_der(der),
+            raw: der.to_vec(),
+        }
+    }
+
+    pub fn from_ed_der(der: &[u8]) -> Self {
+        DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_ed_der(der),
+            raw: der.to_vec(),
+        }
+    }
+
+    pub fn from_ed_components(x: &str) -> jsonwebtoken_dep::errors::Result<Self> {
+        Ok(DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_ed_components(x)?,
+            raw: x.as_bytes().to_vec(),
+        })
+    }
+
+    pub fn from_jwk(jwk: &jsonwebtoken_dep::jwk::Jwk) -> jsonwebtoken_dep::errors::Result<Self> {
+        Ok(DecodingKey {
+            inner: jsonwebtoken_dep::DecodingKey::from_jwk(jwk)?,
+            raw: vec![],
+        })
+    }
+
+    pub fn into_static(self) -> Self {
+        self
+    }
+}
+
+#[derive(Clone)]
+pub struct EncodingKey {
+    pub inner: jsonwebtoken_dep::EncodingKey,
+    pub raw: Vec<u8>,
+}
+
+impl std::fmt::Debug for EncodingKey {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("EncodingKey")
+            .field("raw", &self.raw)
+            .finish()
+    }
+}
+
+impl PartialEq for EncodingKey {
+    fn eq(&self, other: &Self) -> bool {
+        self.raw == other.raw
+    }
+}
+
+impl EncodingKey {
+    pub fn from_secret(secret: &[u8]) -> Self {
+        EncodingKey {
+            inner: jsonwebtoken_dep::EncodingKey::from_secret(secret),
+            raw: secret.to_vec(),
+        }
+    }
+
+    pub fn from_base64_secret(secret: &str) -> jsonwebtoken_dep::errors::Result<Self> {
+        let out = base64::Engine::decode(&base64::engine::general_purpose::STANDARD, secret)
+            .map_err(|_e| jsonwebtoken_dep::errors::ErrorKind::InvalidKeyFormat)?;
+        Ok(EncodingKey {
+            inner: jsonwebtoken_dep::EncodingKey::from_base64_secret(secret)?,
+            raw: out,
+        })
+    }
+
+    pub fn from_rsa_pem(key: &[u8]) -> jsonwebtoken_dep::errors::Result<Self> {
+        Ok(EncodingKey {
+            inner: jsonwebtoken_dep::EncodingKey::from_rsa_pem(key)?,
+            raw: key.to_vec(),
+        })
+    }
+
+    pub fn from_ec_pem(key: &[u8]) -> jsonwebtoken_dep::errors::Result<Self> {
+        Ok(EncodingKey {
+            inner: jsonwebtoken_dep::EncodingKey::from_ec_pem(key)?,
+            raw: key.to_vec(),
+        })
+    }
+
+    pub fn from_ed_pem(key: &[u8]) -> jsonwebtoken_dep::errors::Result<Self> {
+        Ok(EncodingKey {
+            inner: jsonwebtoken_dep::EncodingKey::from_ed_pem(key)?,
+            raw: key.to_vec(),
+        })
+    }
+
+    pub fn from_rsa_der(der: &[u8]) -> Self {
+        EncodingKey {
+            inner: jsonwebtoken_dep::EncodingKey::from_rsa_der(der),
+            raw: der.to_vec(),
+        }
+    }
+
+    pub fn from_ec_der(der: &[u8]) -> Self {
+        EncodingKey {
+            inner: jsonwebtoken_dep::EncodingKey::from_ec_der(der),
+            raw: der.to_vec(),
+        }
+    }
+
+    pub fn from_ed_der(der: &[u8]) -> Self {
+        EncodingKey {
+            inner: jsonwebtoken_dep::EncodingKey::from_ed_der(der),
+            raw: der.to_vec(),
+        }
+    }
+}
+
+pub fn encode<T: serde::ser::Serialize>(
+    header: &Header,
+    claims: &T,
+    key: &EncodingKey,
+) -> jsonwebtoken_dep::errors::Result<String> {
+    jsonwebtoken_dep::encode(header, claims, &key.inner)
+}
+
+pub fn decode<T: serde::de::DeserializeOwned>(
+    token: &str,
+    key: &DecodingKey,
+    validation: &Validation,
+) -> jsonwebtoken_dep::errors::Result<TokenData<T>> {
+    jsonwebtoken_dep::decode(token, &key.inner, validation)
+}
+
+pub fn decode_header(token: &str) -> jsonwebtoken_dep::errors::Result<Header> {
+    jsonwebtoken_dep::decode_header(token)
+}
+
+pub fn dangerous_insecure_decode<T: serde::de::DeserializeOwned>(
+    token: &str,
+) -> jsonwebtoken_dep::errors::Result<TokenData<T>> {
+    let mut validation = Validation::default();
+    validation.insecure_disable_signature_validation();
+    validation.validate_exp = false;
+    validation.required_spec_claims.clear();
+    validation.validate_nbf = false;
+    jsonwebtoken_dep::decode(token, &jsonwebtoken_dep::DecodingKey::from_secret(&[]), &validation)
+}
