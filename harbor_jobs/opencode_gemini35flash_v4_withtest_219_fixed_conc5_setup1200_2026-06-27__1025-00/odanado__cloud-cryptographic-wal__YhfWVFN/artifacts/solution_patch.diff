+
+const originalParam = Common.prototype.param;
+Common.prototype.param = function (
+  this: Common,
+  topic: string,
+  name: string
+): any {
+  const value = originalParam.call(this, topic, name);
+  if (typeof value === "bigint") {
+    return Number(value);
+  }
+  return value;
+};
+
+const originalIsSupportedChainId = Common.isSupportedChainId;
+Common.isSupportedChainId = function (chainId: any): boolean {
+  if (
+    chainId &&
+    typeof chainId === "object" &&
+    typeof chainId.toString === "function"
+  ) {
+    try {
+      return originalIsSupportedChainId(BigInt(chainId.toString()));
+    } catch {
+      // fallback
+    }
+  }
+  return originalIsSupportedChainId(chainId);
+};
 
