+func Wait(ctx context.Context, timeout time.Duration, fn func() *Err) error {
+	return New[struct{}](WithTimeout(timeout), WithRetryFunc(shouldRetry)).Wait(ctx, func(_ context.Context) error {
+		err := fn()
+		if err != nil {
+			return err
+		}
+		return nil
+	})
+}
