+	conn, err := w.Connections.Get(ctx, catalog.GetConnectionRequest{Name: connUpdate.Name})
+	require.NoError(t, err)
+	assert.Equal(t, conn.Options, connUpdate.Options)
+
+	connList, err := w.Connections.ListAll(ctx)
