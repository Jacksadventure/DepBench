+	updated, err := w.Queries.Update(ctx, sql.QueryEditContent{
+		QueryId:      query.Id,
+		Name:         RandomName("go-sdk-updated"),
+		DataSourceId: srcs[0].Id,
+		Description:  "UPDATED: test query from Go SDK",
