+	assert.True(t, len(scopes) >= 1)
+
+	// creates keyName
+	err = w.Secrets.PutSecret(ctx, workspace.PutSecret{
+		Scope:       scopeName,
+		Key:         keyName,
+		StringValue: RandomName("dummy"),
+	})
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		err = w.Secrets.DeleteSecret(ctx, workspace.DeleteSecret{
+			Scope: scopeName,
