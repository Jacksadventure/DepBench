diff --git a/scripts/patch-jwt-decode.js b/scripts/patch-jwt-decode.js
new file mode 100644
index 000000000..62687dc35
--- /dev/null
+++ b/scripts/patch-jwt-decode.js
@@ -0,0 +1,20 @@
+const fs = require("fs");
+const path = require("path");
+
+function patch(filePath) {
+    if (!fs.existsSync(filePath)) {
+        console.warn(`File not found: ${filePath}`);
+        return;
+    }
+    let content = fs.readFileSync(filePath, "utf8");
+    if (!content.includes("export default jwtDecode;")) {
+        content += "\nexport default jwtDecode;\n";
+        fs.writeFileSync(filePath, content, "utf8");
+        console.log(`Successfully patched: ${filePath}`);
+    } else {
+        console.log(`Already patched: ${filePath}`);
+    }
+}
+
+patch(path.join(__dirname, "../node_modules/jwt-decode/build/cjs/index.d.ts"));
+patch(path.join(__dirname, "../node_modules/jwt-decode/build/esm/index.d.ts"));
