new file mode 100644
index 0000000..8cb7c37
--- /dev/null
+++ b/clap_compat/src/lib.rs
@@ -0,0 +1,15 @@
+pub use real_clap::*;
+
+pub trait IntoApp {
+    fn command() -> real_clap::Command;
+    fn into_app() -> real_clap::Command;
+}
+
+impl<T: real_clap::CommandFactory> IntoApp for T {
+    fn command() -> real_clap::Command {
+        T::command()
+    }
+    fn into_app() -> real_clap::Command {
+        T::command()
+    }
+}
