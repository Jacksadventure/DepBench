+}
+
+func (ts *readerTestSuite) TestErrorForNotRegistered() {
+	err := ts.Reader.Collect(context.Background(), &metricdata.ResourceMetrics{})
+	ts.ErrorIs(err, ErrReaderNotRegistered)
+}
+
+func (ts *readerTestSuite) TestSDKProducer() {
