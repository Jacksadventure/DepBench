+
+		sfCounter, _ = meter.Float64Counter("sync.float64.counter")
+		sfUpDownCounter, _ = meter.Float64UpDownCounter("sync.float64.up.down.counter")
+		sfHistogram, _ = meter.Float64Histogram("sync.float64.histogram")
