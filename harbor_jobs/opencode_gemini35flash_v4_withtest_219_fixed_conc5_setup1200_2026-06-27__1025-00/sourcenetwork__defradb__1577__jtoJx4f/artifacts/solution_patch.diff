+				_, matches := v(instrument)
+				assert.Truef(t, matches, "view does not match %#v", instrument)
+			}
+
+			for _, instrument := range test.notMatches {
+				_, matches := v(instrument)
+				assert.Falsef(t, matches, "view matches %#v", instrument)
+			}
+		})
+	}
