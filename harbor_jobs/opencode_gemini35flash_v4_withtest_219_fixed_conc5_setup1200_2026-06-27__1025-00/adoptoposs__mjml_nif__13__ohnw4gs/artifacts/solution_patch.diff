 #[rustler::nif]
 pub fn to_html<'a>(env: Env<'a>, mjml: String) -> NifResult<Term<'a>> {
-    return match mrml::to_html(&mjml, mrml::Options::default()) {
+    if !is_well_formed(&mjml) {
+        return Ok((atoms::error(), "Couldn't convert MJML template").encode(env));
+    }
+    let root = match mrml::parse(&mjml) {
+        Ok(r) => r,
+        Err(_) => return Ok((atoms::error(), "Couldn't convert MJML template").encode(env)),
+    };
+    return match root.render(&mrml::prelude::render::Options::default()) {
         Ok(content) => Ok((atoms::ok(), content).encode(env)),
         Err(_) => Ok((atoms::error(), "Couldn't convert MJML template").encode(env)),
     };
