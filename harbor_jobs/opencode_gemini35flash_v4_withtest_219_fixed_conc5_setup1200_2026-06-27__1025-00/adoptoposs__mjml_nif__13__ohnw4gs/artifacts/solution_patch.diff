+fn is_well_formed(xml: &str) -> bool {
+    let mut tokenizer = xmlparser::Tokenizer::from(xml);
+    let mut stack = Vec::new();
+    while let Some(token_result) = tokenizer.next() {
+        let token = match token_result {
+            Ok(t) => t,
+            Err(_) => return false,
+        };
+        match token {
+            xmlparser::Token::ElementStart { local, .. } => {
+                stack.push(local.as_str());
+            }
+            xmlparser::Token::ElementEnd { end, .. } => {
+                match end {
+                    xmlparser::ElementEnd::Empty => {
+                        if stack.pop().is_none() {
+                            return false;
+                        }
+                    }
+                    xmlparser::ElementEnd::Close(_, local) => {
+                        match stack.pop() {
+                            Some(open_tag) if open_tag == local.as_str() => {}
+                            _ => return false,
+                        }
+                    }
+                    xmlparser::ElementEnd::Open => {}
+                }
+            }
+            _ => {}
+        }
+    }
+    stack.is_empty()
+}
