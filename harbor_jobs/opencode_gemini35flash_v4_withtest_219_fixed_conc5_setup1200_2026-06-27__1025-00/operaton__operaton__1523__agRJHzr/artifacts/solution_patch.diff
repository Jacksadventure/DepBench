+package org.operaton.bpm.engine.rest.openapi.generator.impl;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+/**
+ * Tests the {@link SchemaValidator} class.
+ */
+class SchemaValidatorTest {
+
+  @TempDir
+  Path tempDir;
+
+  @Test
+  void testValidationSuccess() throws Exception {
+    Path schemaFile = tempDir.resolve("schema.json");
+    Path inputFile = tempDir.resolve("input.json");
+
+    String schema = "{\n" +
+            "  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n" +
+            "  \"type\": \"object\",\n" +
+            "  \"properties\": {\n" +
+            "    \"name\": { \"type\": \"string\" }\n" +
+            "  },\n" +
+            "  \"required\": [\"name\"]\n" +
+            "}\n";
+    String input = "{\n" +
+            "  \"name\": \"Operaton\"\n" +
+            "}\n";
+
+    Files.writeString(schemaFile, schema);
+    Files.writeString(inputFile, input);
+
+    SchemaValidator.main(new String[]{schemaFile.toString(), inputFile.toString()});
+    // Should pass without throwing exception
+  }
+
+  @Test
+  void testValidationFailure() throws Exception {
+    Path schemaFile = tempDir.resolve("schema.json");
+    Path inputFile = tempDir.resolve("input.json");
+
+    String schema = "{\n" +
+            "  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n" +
+            "  \"type\": \"object\",\n" +
+            "  \"properties\": {\n" +
+            "    \"name\": { \"type\": \"string\" }\n" +
+            "  },\n" +
+            "  \"required\": [\"name\"]\n" +
+            "}\n";
+    String input = "{\n" +
+            "  \"number\": 123\n" +
+            "}\n";
+
+    Files.writeString(schemaFile, schema);
+    Files.writeString(inputFile, input);
+
+    assertThatThrownBy(() -> SchemaValidator.main(new String[]{schemaFile.toString(), inputFile.toString()}))
+        .isInstanceOf(RuntimeException.class)
+        .hasMessageContaining("Schema validation errors");
+  }
+
+  @Test
+  void testInvalidArguments() {
+    assertThatThrownBy(() -> SchemaValidator.main(new String[]{"only-one-arg"}))
+        .isInstanceOf(RuntimeException.class)
+        .hasMessageContaining("Must provide two arguments");
+  }
+}
