+    - badCond
+    - caseOrder
+    - codegenComment
+    - commentedOutCode
+    - deprecatedComment
+    - dupArg
+    - dupBranchBody
+    - dupCase
+    - dupSubExpr
+    - exitAfterDefer
+    - flagDeref
+    - flagName
+    - nilValReturn
+    - offBy1
+    - sloppyReassign
+    - weakCond
+    - octalLiteral
+
+    # Performance
+    - appendCombine
+    - equalFold
+    - hugeParam
+    - indexAlloc
+    - rangeExprCopy
+    - rangeValCopy
+
+    # Style
+    - assignOp
+    - boolExprSimplify
+    - captLocal
+    - commentFormatting
+    - commentedOutImport
+    - defaultCaseOrder
+    - docStub
+    - elseif
+    - emptyFallthrough
+    - emptyStringTest
+    - hexLiteral
+    - ifElseChain
+    - methodExprCall
+    - regexpMust
+    - singleCaseSwitch
+    - sloppyLen
+    - stringXbytes
+    - switchTrue
+    - typeAssertChain
+    - typeSwitchVar
+    - underef
+    - unlabelStmt
+    - unlambda
+    - unslice
+    - valSwap
+    - wrapperFunc
+    - yodaStyleExpr
+
+    # Opinionated
+    - builtinShadow
+    - importShadow
+    - initClause
+    - nestingReduce
+    - paramTypeCombine
+    - ptrToRefParam
+    - typeUnparen
+    - unnamedResult
+    - unnecessaryBlock
