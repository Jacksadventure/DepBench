+// for width 80, directory is hidden (if not identical)
+var tableTwo = "NAME    STATUS     SSH            VMTYPE    ARCH       CPUS    MEMORY    DISK\n" +
+	"foo     Stopped    127.0.0.1:0    qemu      x86_64     0       0B        0B\n" +
