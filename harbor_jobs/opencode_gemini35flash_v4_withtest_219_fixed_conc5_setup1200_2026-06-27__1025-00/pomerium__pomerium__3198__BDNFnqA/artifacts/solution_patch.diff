+func TestNewAccount(t *testing.T) {
+	am := &ACMEIssuer{CA: dummyCA}
+	testConfig := &Config{
+		Issuers:   []Issuer{am},
+		Storage:   &FileStorage{Path: "./_testdata_tmp"},
