+package certmagic
+
+// ACMEManager is a compatibility type alias for ACMEIssuer
+type ACMEManager = ACMEIssuer
+
+// NewACMEManager is a compatibility function wrapper for NewACMEIssuer
+func NewACMEManager(cfg *Config, template ACMEManager) *ACMEIssuer {
+	return NewACMEIssuer(cfg, template)
+}
