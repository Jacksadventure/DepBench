diff --git a/internal/hcops/action.go b/internal/hcops/action.go
index ed67aefc..400a8864 100644
--- a/internal/hcops/action.go
+++ b/internal/hcops/action.go
@@ -2,6 +2,8 @@ package hcops
 
 import (
 	"context"
+	"fmt"
+	"time"
 
 	"github.com/hetznercloud/hcloud-go/v2/hcloud"
 )
@@ -11,6 +13,33 @@ type HCloudActionClient interface {
 }
 
 func WatchAction(ctx context.Context, ac HCloudActionClient, a *hcloud.Action) error {
+	if client, ok := ac.(interface {
+		GetByID(context.Context, int64) (*hcloud.Action, *hcloud.Response, error)
+	}); ok {
+		ticker := time.NewTicker(50 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return ctx.Err()
+			case <-ticker.C:
+				updatedAction, _, err := client.GetByID(ctx, a.ID)
+				if err != nil {
+					return err
+				}
+				if updatedAction == nil {
+					return fmt.Errorf("action %d not found", a.ID)
+				}
+				if updatedAction.Status == hcloud.ActionStatusSuccess {
+					return nil
+				}
+				if updatedAction.Status == hcloud.ActionStatusError {
+					return updatedAction.Error()
+				}
+			}
+		}
+	}
+
 	_, errCh := ac.WatchProgress(ctx, a)
 	err := <-errCh
 	return err
