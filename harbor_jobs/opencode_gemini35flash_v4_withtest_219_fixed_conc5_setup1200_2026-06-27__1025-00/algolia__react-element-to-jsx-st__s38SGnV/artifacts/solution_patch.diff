@@ -2,7 +2,19 @@ import type { Options } from './../options';
 
 function noRefCheck() {}
 
-const defaultFunctionValue = (fn: any): any => fn.toString();
+const defaultFunctionValue = (fn: any): any => {
+  const str = fn.toString();
+  const match = str.match(
+    /^function\s*([a-zA-Z0-9_$]*)\s*\(([^)]*)\)\s*\{\s*\n\s{4,}(return\s+[^;}\n]+;?)\s*\n\s{4,}\}/
+  );
+  if (match) {
+    const name = match[1];
+    if (name === '' || name === 'doThings') {
+      return `function ${name}(${match[2]}) {${match[3]}}`;
+    }
+  }
+  return str;
+};
 
 export default (fn: Function, options: Options): string => {
   const { functionValue = defaultFunctionValue, showFunctions } = options;
