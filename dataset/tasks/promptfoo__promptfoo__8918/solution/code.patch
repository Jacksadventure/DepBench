+function getOpenCodeCacheDetails(cache: OpenCodeTokenCache | undefined): {
+  read: number;
+  write: number;
+} {
+  if (typeof cache === 'number') {
+    return { read: cache, write: 0 };
+  }
+  if (!cache || typeof cache !== 'object') {
+    return { read: 0, write: 0 };
+  }
+  return {
+    read: cache.read ?? 0,
+    write: cache.write ?? 0,
+  };
+}
