+    // `options.foo` has `string` type
 
-const foo = hook(function(foo) {
-  // handle `foo`
-  foo.bar = 'another-string'
-}, {bar: 'random-string'})
+    // not allowed, because it does not satisfy the `R` type
+    return { foo: 42 };
 
-// foo outputs
-{
-  bar: 'another-string',
-  num: 123
-}
+    // allowed
+    return { bar: 42 };
+  },
+  { foo: "Forty-Two" }
