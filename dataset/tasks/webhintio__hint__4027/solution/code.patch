diff --git a/packages/utils-css/src/get-unprefixed.ts b/packages/utils-css/src/get-unprefixed.ts
new file mode 100644
index 00000000000..83e4ff989df
--- /dev/null
+++ b/packages/utils-css/src/get-unprefixed.ts
@@ -0,0 +1,10 @@
+/**
+ * Returns the input property with the vendor prefix removed.
+ * NOTE: This code is extracted from the package postcss because
+ * they have removed this features from their code.
+ * @param {string} prop Property to remove the prefix.
+ * @returns {string} String without the vendor prefix.
+ */
+export const getUnprefixed = (prop: string): string => {
+    return prop.replace(/^-\w+-/, '');
+};
diff --git a/packages/utils-css/src/get-vendor-prefix.ts b/packages/utils-css/src/get-vendor-prefix.ts
new file mode 100644
index 00000000000..8a9e6a7cf63
--- /dev/null
+++ b/packages/utils-css/src/get-vendor-prefix.ts
@@ -0,0 +1,16 @@
+/**
+ * Returns the vendor prefix from an string.
+ * NOTE: This code is extracted from the package postcss because
+ * they have removed this features from their code.
+ * @param {string} prop Property to extract the prefix.
+ * @returns {string} The prefix in the property.
+ */
+export const getVendorPrefix = (prop: string): string => {
+    const match = prop.match(/^(-\w+-)/);
+
+    if (match) {
+        return match[0];
+    }
+
+    return '';
+};
