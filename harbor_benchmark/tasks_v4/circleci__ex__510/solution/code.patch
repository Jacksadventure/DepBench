diff --git a/closer/closer.go b/closer/closer.go
new file mode 100644
index 000000000..26330923f
--- /dev/null
+++ b/closer/closer.go
@@ -0,0 +1,13 @@
+/*
+Package closer contains a helper function for not losing deferred errors
+*/
+package closer
+
+import "io"
+
+func ErrorHandler(c io.Closer, in *error) {
+	cerr := c.Close()
+	if *in == nil {
+		*in = cerr
+	}
+}
