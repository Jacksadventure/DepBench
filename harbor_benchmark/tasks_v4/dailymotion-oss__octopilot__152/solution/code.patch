-			if text[i] == '\n' {
-				line--
-			}
-		}
-		col = 0
-		for i := tc; i >= 0; i-- {
-			if text[i] == '\n' {
-				break
-			}
-			col++
-		}
-		return line, col
-	}
-	for i := prevTC + 1; i <= tc && i < len(text); i++ {
-		if text[i] == '\n' {
-			col = 0
-			line++
-		} else {
-			col++
-		}
-	}
-	if prevTC == tc && tc == 0 && tc < len(text) {
-		if text[tc] == '\n' {
-			line++
-			col--
-		}
-	}
-	return line, col
-}
