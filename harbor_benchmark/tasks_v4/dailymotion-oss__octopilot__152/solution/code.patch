-			fline, fcol := computeLineCol(text, 0, tc, 1, 1)
-			err := &UnconsumedInput{
-				StartTC:     startTC,
-				FailTC:      tc,
-				StartLine:   sline,
-				StartColumn: scol,
-				FailLine:    fline,
-				FailColumn:  fcol,
-				Text:        text,
-			}
-			return tc, nil, err, scan
-		} else {
-			return tc, nil, nil, nil
-		}
-	}
