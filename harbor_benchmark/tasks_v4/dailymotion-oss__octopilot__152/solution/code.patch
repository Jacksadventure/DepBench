+}
+
+func (je *jsonEncoder) Encode(writer io.Writer, node *yaml.Node) error {
+
+	destination := writer
+	tempBuffer := bytes.NewBuffer(nil)
+	if je.colorise {
+		destination = tempBuffer
+	}
+
+	var encoder = json.NewEncoder(destination)
